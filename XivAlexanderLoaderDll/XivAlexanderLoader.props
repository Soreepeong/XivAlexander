<?xml version="1.0" encoding="utf-8"?>
<!-- What XivAlexanderLoader32.vcxproj and XivAlexanderLoader64.vcxproj share; each sets its platform, TargetName, VcpkgTriplet and .def. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutDir>$(SolutionDir)build\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\$(Configuration)\Temp_$(Platform)_$(ProjectName)\</IntDir>
    <TargetExt>.dll</TargetExt>
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgOverlayTriplets>$(SolutionDir)triplets</VcpkgOverlayTriplets>
    <VcpkgInstalledDir>$(SolutionDir)build\vcpkg_$(Platform)_$(PlatformToolset)_$(ProjectName)\</VcpkgInstalledDir>
    <VcpkgAdditionalInstallOptions>--feature-flags=versions</VcpkgAdditionalInstallOptions>
    <VcpkgUseStatic>true</VcpkgUseStatic>
  </PropertyGroup>
  <!-- No C runtime: the DLL is loaded into game launchers and the game, and must stay small (see Base.h). -->
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalOptions>/utf-8 /Zc:threadSafeInit- %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>_WINDLL;_HAS_EXCEPTIONS=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ExceptionHandling>false</ExceptionHandling>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <SupportJustMyCode>false</SupportJustMyCode>
      <ControlFlowGuard>false</ControlFlowGuard>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <IgnoreAllDefaultLibraries>true</IgnoreAllDefaultLibraries>
      <EntryPointSymbol>DllMain</EntryPointSymbol>
      <AdditionalDependencies>kernel32.lib;user32.lib;version.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <CustomBuildStep>
      <Command>set /p CERT_PASSWORD= &lt; "$(SolutionDir)Build\CertificatePassword.txt"
"$(FrameworkSDKDir)bin\$(TargetPlatformVersion)\x86\signtool.exe" sign /tr http://timestamp.digicert.com /td sha256 /v /fd sha256 /f "$(SolutionDir)Build\Certificate.pfx" /p "%25CERT_PASSWORD%25" "$(TargetPath)" &gt; "$(TargetPath).sign.txt"
</Command>
      <Message>Signing $(TargetPath)</Message>
      <Outputs>$(TargetPath).sign.txt</Outputs>
    </CustomBuildStep>
    <PostBuildEvent>
      <Command>copy /y "$(TargetPath)" "$(LOCALAPPDATA)\XivAlexander\" || cd.
</Command>
    </PostBuildEvent>
    <ResourceCompile>
      <NullTerminateStrings>true</NullTerminateStrings>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MinSpace</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="Base.h" />
    <ClInclude Include="Json.h" />
    <ClInclude Include="resource.h" />
    <ClInclude Include="x86.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="Base.cpp" />
    <ClCompile Include="Config.cpp" />
    <ClCompile Include="EntryPoint.cpp" />
    <ClCompile Include="Follow.cpp" />
    <ClCompile Include="Json.cpp" />
    <ClCompile Include="Runtime.cpp">
      <WholeProgramOptimization>false</WholeProgramOptimization>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="Loader.rc" />
  </ItemGroup>
  <ItemGroup>
    <None Include="vcpkg.json" />
  </ItemGroup>
  <!-- A relinked target is unsigned, but the signing step would count its old log as up to date. -->
  <Target Name="ForgetSigningOnRelink" AfterTargets="Link" Condition="'$(LinkSkippedExecution)' == 'false'">
    <Delete Files="$(TargetPath).sign.txt" />
  </Target>
</Project>
