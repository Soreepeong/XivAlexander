    BEGIN
        MENUITEM "Always on &Top\tCtrl+T",      ID_VIEW_ALWAYSONTOP
        MENUITEM SEPARATOR
        MENUITEM "Use &Word Wrap\tCtrl+P",      ID_VIEW_USEWORDWRAP
    END
END


