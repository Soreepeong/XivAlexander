STRINGTABLE
BEGIN
    IDS_SETTINGS_CROWDFIX_ENABLED "Enable CrowdFix"
    IDS_SETTINGS_CROWDFIX_ENABLED_DESC 
                            "Reduces per-frame work that grows with the number of objects around. Changes apply from the next frame. Turn individual fixes off if you see visual glitches."
    IDS_SETTINGS_CROWDFIX_SKIPIDLENOTIFIERS "Skip idle GPU resource notifiers"
    IDS_SETTINGS_CROWDFIX_SKIPIDLENOTIFIERS_DESC 
                            "Walks only the GPU resources that do per-frame work, instead of every resource twice per frame."
    IDS_SETTINGS_CROWDFIX_CHAINWORKERWAKEUPS "Chain job worker wake-ups"
    IDS_SETTINGS_CROWDFIX_CHAINWORKERWAKEUPS_DESC 
                            "Wakes one sleeping worker per job submit, and lets each woken worker wake the next, instead of waking every worker from the submitting thread."
    IDS_SETTINGS_CROWDFIX_DEDUPESKELETONSYNCS 
                            "Sync skeleton poses once per frame"
    IDS_SETTINGS_CROWDFIX_DEDUPESKELETONSYNCS_DESC 
                            "Skips the pose syncs of every skeleton that repeat for each rendered view after the first one in a frame."
    IDS_SETTINGS_CROWDFIX_TRIMCULLINGCLEAR "Clear only the used culling slots"
    IDS_SETTINGS_CROWDFIX_TRIMCULLINGCLEAR_DESC 
                            "Clears the visibility table only up to the highest object slot ever used, instead of all 40,960 slots several times per frame."
    IDS_SETTINGS_CROWDFIX_SHORTENALLOCATORLOCK 
                            "Free large graphics blocks outside the allocator lock"
    IDS_SETTINGS_CROWDFIX_SHORTENALLOCATORLOCK_DESC 
                            "Lets small allocations proceed while large blocks are being freed. Mostly helps on CPUs where the main thread waits for the job workers."
    IDS_SETTINGS_CROWDFIX_POOLSTAGINGBLOCKS "Pool draw staging blocks"
    IDS_SETTINGS_CROWDFIX_POOLSTAGINGBLOCKS_DESC 
                            "Reuses freed staging blocks by size, so most allocations skip the allocator's global locks."
END

STRINGTABLE
BEGIN
    IDS_SETTINGS_CROWDFIX_FREEZEHIDDENMINIONS 
                            "Freeze the follow AI of hidden minions"
    IDS_SETTINGS_CROWDFIX_FREEZEHIDDENMINIONS_DESC 
                            "Skips the follow AI, with its collision sweeps, of minions whose model is hidden. They still warp back to their owner when left behind."
    IDS_SETTINGS_CROWDFIX_SKIPPREPAREWAIT "Skip the redundant job list wait"
    IDS_SETTINGS_CROWDFIX_SKIPPREPAREWAIT_DESC 
                            "Removes a second wait on an event that is always already signaled: about 75 system calls per frame."
    IDS_SETTINGS_CROWDFIX_INLINEBGPREP 
                            "Run background instancing prep on the main thread"
    IDS_SETTINGS_CROWDFIX_INLINEBGPREP_DESC 
                            "Runs the tiny per-view background instancing job right away, instead of handing it to a worker and waiting for it."
    IDS_SETTINGS_CROWDFIX_SKIPHIDDENHOTBARS "Skip preparing hidden hotbars"
    IDS_SETTINGS_CROWDFIX_SKIPHIDDENHOTBARS_DESC 
                            "Skips preparing the slots of hidden hotbars every frame. A bar that becomes visible is prepared in that same frame."
    IDS_SETTINGS_CROWDFIX_PARALLELANIMTAIL "Finish animations in parallel"
    IDS_SETTINGS_CROWDFIX_PARALLELANIMTAIL_DESC 
                            "Finishes the skeletons of each attach depth on the job workers, instead of one by one on the main thread."
    IDS_SETTINGS_CROWDFIX_SPLITCHARACTERCULLING 
                            "Split character culling across threads"
    IDS_SETTINGS_CROWDFIX_SPLITCHARACTERCULLING_DESC 
                            "The game culls all characters in a single job; this lets every thread that finishes its own culling work help with it."
    IDS_SETTINGS_CROWDFIX_PERITEMCULLINGCLAIMS 
                            "Hand out culling work one item at a time"
    IDS_SETTINGS_CROWDFIX_PERITEMCULLINGCLAIMS_DESC 
                            "Spreads cell culling over more threads, instead of handing out blocks of up to 8 items that only a few threads get."
    IDS_SETTINGS_CROWDFIX_GATHERUSEDCOMMANDS 
                            "Gather only the used command list entries"
    IDS_SETTINGS_CROWDFIX_GATHERUSEDCOMMANDS_DESC 
                            "Copies only the used entries of each command list, and skips sorting them when they are already in order. The result is the same as the game's."
END

