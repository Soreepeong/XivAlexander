STRINGTABLE
BEGIN
    IDS_SETTINGS_OPCODECONFIG_DESC 
                            "Filled in by the opcode updater; edit only if you know the values for this game version."
    IDS_SETTINGS_SQPACKROOTS_DESC 
                            "Installations of other clients: their text can be merged in, and files this game lacks, such as other languages' voices, are taken from them; see Languages. Changing this takes effect after restarting the game."
    IDS_SETTINGS_FILEENTRYROOTS_DESC 
                            "Folders whose files, placed at their game paths, replace the game's own. Drag to reorder. <config> is the configuration folder, and <sqpack> is the game's sqpack folder."
    IDS_SETTINGS_TTMPDIRS_DESC 
                            "Folders TexTools ModPacks are looked for in; imported ones go into the first. Drag to reorder. <config> is the configuration folder, and <sqpack> is the game's sqpack folder."
    IDS_SETTINGS_LOCK_MODE_DESC 
                            "Renders at a fixed interval chosen so that your global cooldown ends just before a frame, losing less time to waiting for the next one. Automatic uses the cooldown the latency helper measures."
    IDS_SETTINGS_TITLEFORMAT_NOTE 
                            "Placeholders in the title formats: {title}, {pid}, {alias}, {alias_or_pid}."
    IDS_SETTINGS_DISABLEGHOSTING_DESC 
                            "Stops Windows from replacing a busy game window with a ""Not Responding"" frame; turning it off takes effect after restarting the game."
    IDS_SETTINGS_CHAINLOAD_DESC 
                            "DLLs loaded in place of the system's, in order, e.g. to use ReShade alongside XivAlexander; used only while XivAlexander is installed as that DLL. Changing this takes effect after restarting the game."
    IDS_SETTINGS_SAMPLINGRATE_DESC 
                            "The rate the game mixes its audio at. Changing this takes effect after restarting the game."
    IDS_SETTINGS_RESTART_OBFUSCATION_TIP 
                            "Encodes the launch arguments, such as the session ID, as the official launcher does, so they can't be read from the command line."
    IDS_SETTINGS_REMEMBER_TIP 
                            "Keeps the choice for later restarts and copied command lines, and for starting the game with a stored login session."
    IDS_SETTINGS_MITIGATIONMODE_TIP 
                            "Mode 1 takes only your ping off the lock. Mode 2 acts as if every round trip took the set time. Mode 3 estimates the server's own delay from statistics, which also suits VPNs that alter ping."
    IDS_SETTINGS_NETWORK_LOGGING_TIP 
                            "Writes each action, its measured delays, and the adjusted lock to the log window."
    IDS_SETTINGS_REDUCEPACKETDELAY_TIP 
                            "Turns off delayed acknowledgements and Nagle's algorithm on game connections made afterwards."
    IDS_SETTINGS_RESETCONNECTIONS_TIP 
                            "After asking, forcibly closes every game connection XivAlexander knows of, as if the connection was lost."
    IDS_SETTINGS_OPCODEFINDER_TIP 
                            "Logs messages as long as those the latency helper reads, with hex dumps, to help find opcodes after a patch."
END

STRINGTABLE
BEGIN
    IDS_SETTINGS_ALTCODEC_TIP 
                            "Plays music files whose audio is FLAC or WAV, as some music mods have."
    IDS_SETTINGS_LOGGING_ALLDATAFILEREAD_TIP 
                            "Logs every read from the game's data files, with its offset and size."
    IDS_SETTINGS_LOGGING_HASHTRACKERKEYS_TIP 
                            "Logs the file paths the game looks up, as All file paths does."
    IDS_SETTINGS_LOGGING_ALLPATHS_TIP 
                            "Logs every file path the game looks up, and where it was found."
    IDS_SETTINGS_LOGGING_REPLACEDPATHS_TIP 
                            "Logs only the paths changed by path replacements or per-character languages."
    IDS_SETTINGS_LOGGING_DIALOGUENAMES_TIP 
                            "Logs the speaker names of cutscene voices, as per-character languages take them."
    IDS_SETTINGS_FONT_ENABLED_TIP 
                            "Draws game text with the fonts set for each family instead of the game's own."
    IDS_SETTINGS_FONT_SYSTEMFALLBACK_TIP 
                            "Draws characters the chosen fonts lack with Windows' fallback fonts instead of the game's glyphs."
    IDS_SETTINGS_FONT_MONOSPACEDDIGITS_TIP 
                            "For system fonts: uses the font's tabular digits, or else centers each digit in a cell as wide as 0, so that numbers don't shift as they change."
    IDS_SETTINGS_USEMORECPUTIME_TIP 
                            "While the game is in the foreground, skips its short sleeps and waits for locked frames by spinning: steadier frame timing for more CPU time."
    IDS_SETTINGS_SYNCHRONIZEPROCESSING_TIP 
                            "Starts a frame right when an animation lock or cooldown ends, so the game takes your next action as soon as it can."
    IDS_SETTINGS_LOCK_MAXDEVIATION_TIP 
                            "How much earlier than planned a frame may come; a cooldown ending closer than this before a frame counts as ending on the next one."
    IDS_SETTINGS_SOXR_ENABLED_TIP 
                            "Resamples voices with soxr instead of the game's linear interpolation; applies to voices started afterwards."
    IDS_SETTINGS_SOXR_FILTER_TIP 
                            "A number left at 0 uses the quality preset's value. Changes apply to voices started afterwards."
    IDS_SETTINGS_SOXR_QUALITY_TIP 
                            "The quality preset, from Quick (cubic interpolation) to 32-bit; Bits20 is soxr's high quality."
    IDS_SETTINGS_SOXR_PHASE_TIP 
                            "Minimum phase delays the sound the least; Linear keeps the waveform's shape but delays it more."
END

STRINGTABLE
BEGIN
    IDS_SETTINGS_SOXR_STEEPFILTER_TIP 
                            "Moves the passband edge up towards the Nyquist frequency."
    IDS_SETTINGS_SOXR_PASSBANDEND_TIP 
                            "Where the passband ends, as a fraction of the lower Nyquist frequency, between 0 and 1."
    IDS_SETTINGS_SOXR_STOPBANDBEGIN_TIP 
                            "Where attenuation begins, as a fraction of the lower Nyquist frequency; above the passband end."
    IDS_SETTINGS_SOXR_ROLLOFF_TIP 
                            "How much the passband may roll off: Small (0.01 dB at most), Medium (0.35 dB at most), or None."
    IDS_SETTINGS_SOXR_DOUBLEPRECISION_TIP 
                            "Computes in double precision instead of single."
    IDS_SETTINGS_SOXR_HIGHPRECISIONCLOCK_TIP 
                            "Keeps time more accurately for rate ratios that aren't simple fractions."
    IDS_SETTINGS_SOXR_LOG2MINDFT_TIP 
                            "Log2 of the smallest DFT size, 8 to 15; with the large one, it sets most of soxr's delay."
    IDS_SETTINGS_SOXR_LOG2LARGEDFT_TIP 
                            "Log2 of the large DFT size, 8 to 20; with the smallest one, it sets most of soxr's delay."
    IDS_SETTINGS_IMEMODEINDICATOR_TIP 
                            "The game takes every IME for a Japanese one unless the client is Korean or Chinese; this makes the chat's input mode indicator and full-width input right for every CJK IME."
    IDS_SETTINGS_OODLETCP_TIP 
                            "Whether the game's packet compression runs in its TCP mode, as the game's connections use."
    IDS_SETTINGS_SERVERIPRANGE_TIP 
                            "Server addresses whose connections are handled: addresses, ranges (a-b), or CIDR blocks (a/n), separated by commas; empty for all."
    IDS_SETTINGS_SERVERPORTRANGE_TIP 
                            "Server ports whose connections are handled: ports or ranges (a-b), separated by commas; empty for all."
    IDS_SETTINGS_VOICELIPSYNC_TIP 
                            "Lip sync exists for Japanese, English, German and French only; other voice languages keep the game's own lip sync."
END

