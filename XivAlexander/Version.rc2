// Version resource shared by every binary; included through TEXTINCLUDE 3, so the resource editor leaves it alone.
// XIVALEXANDER_LOADER_EXE and XIVALEXANDER_LOADER_DLL pick the description; IsXivAlexanderDll matches it.

#include "Version.h"

#if defined(XIVALEXANDER_LOADER_EXE)
#define XIVALEXANDER_VERSION_DESCRIPTION "XivAlexander Loader"
#define XIVALEXANDER_VERSION_INTERNALNAME "XivAlexanderLoader.exe"
#define XIVALEXANDER_VERSION_FILETYPE VFT_APP
#elif defined(XIVALEXANDER_LOADER_DLL)
#define XIVALEXANDER_VERSION_DESCRIPTION "XivAlexander Loader DLL"
#define XIVALEXANDER_VERSION_INTERNALNAME "XivAlexanderLoader.dll"
#define XIVALEXANDER_VERSION_FILETYPE VFT_DLL
#else
#define XIVALEXANDER_VERSION_DESCRIPTION "XivAlexander Main DLL"
#define XIVALEXANDER_VERSION_INTERNALNAME "XivAlexander.dll"
#define XIVALEXANDER_VERSION_FILETYPE VFT_DLL
#endif

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION XIVALEXANDER_VERSION_MAJOR,XIVALEXANDER_VERSION_MINOR,XIVALEXANDER_VERSION_BUILD,XIVALEXANDER_VERSION_REVISION
 PRODUCTVERSION XIVALEXANDER_VERSION_MAJOR,XIVALEXANDER_VERSION_MINOR,XIVALEXANDER_VERSION_BUILD,XIVALEXANDER_VERSION_REVISION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE XIVALEXANDER_VERSION_FILETYPE
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040004b0"
        BEGIN
            VALUE "CompanyName", "Soreepeong"
            VALUE "FileDescription", XIVALEXANDER_VERSION_DESCRIPTION
            VALUE "FileVersion", XIVALEXANDER_VERSION_STRING
            VALUE "InternalName", XIVALEXANDER_VERSION_INTERNALNAME
            VALUE "LegalCopyright", "Copyright (C) 2021"
            VALUE "OriginalFilename", XIVALEXANDER_VERSION_INTERNALNAME
            VALUE "ProductName", "XivAlexander"
            VALUE "ProductVersion", XIVALEXANDER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x400, 1200
    END
END
